# Producción (VM de Oracle). Copiar a .env en la raíz del repo y completar.
# Nunca subir el .env a git.

# Dominio público que apunta a la IP de la VM (ej. ourhouse.duckdns.org)
DOMAIN=

# Oracle Autonomous Database (Always Free)
DB_USER=ADMIN
DB_PASSWORD=
# Cadena de conexión TLS de la consola de OCI (Database connection > TLS, servicio _low)
DB_CONNECT_STRING=
# Solo con wallet (mTLS): descomprimir el wallet en ./wallet y descomentar
# DB_WALLET_DIR=/app/wallet
# DB_WALLET_PASSWORD=
DB_POOL_MAX=4

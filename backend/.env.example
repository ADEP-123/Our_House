# Copiar a .env para desarrollo local. En producción estas variables se definen en Vercel.
PORT=3000
NODE_ENV=development

# Neon > tu proyecto > Connect > marca "Connection pooling" y copia la cadena
DATABASE_URL=postgresql://usuario:clave@ep-xxxx-pooler.us-west-2.aws.neon.tech/neondb?sslmode=require
DB_POOL_MAX=5

# Copiar a .env (local) o al .env de la raíz (producción con docker compose)
PORT=3000
NODE_ENV=development

# Oracle Autonomous Database (Always Free)
DB_USER=ADMIN
DB_PASSWORD=cambia-esto
# TLS sin wallet: la cadena "TLS" de la consola de OCI (Database connection > TLS)
# Con wallet (mTLS): el alias de tnsnames.ora, ej. ourhouse_low
DB_CONNECT_STRING=
# Solo si usas wallet (mTLS): carpeta con tnsnames.ora y ewallet.pem
DB_WALLET_DIR=
DB_WALLET_PASSWORD=
DB_POOL_MAX=4

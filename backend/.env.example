# Copiar a .env para desarrollo local. En producción estas variables se definen en Vercel (proyecto our-house-api).
PORT=3000
NODE_ENV=development

# URL pública de la PWA (en producción: https://our-house-fawn.vercel.app). Se usa en los enlaces de los correos.
APP_URL=http://localhost:4200

# Secreto para firmar las sesiones (JWT). Obligatorio en producción, mínimo 32 caracteres.
JWT_SECRET=

# Neon > tu proyecto > Connect > marca "Connection pooling" y copia la cadena
DATABASE_URL=postgresql://usuario:clave@ep-xxxx-pooler.us-west-2.aws.neon.tech/neondb?sslmode=require
DB_POOL_MAX=5

# Gmail SMTP: SMTP_USER es el Gmail de la app y SMTP_PASS su contraseña de aplicación (16 letras, sin espacios).
# Si se dejan vacías, los correos se escriben en la consola en vez de enviarse.
SMTP_USER=
SMTP_PASS=
MAIL_FROM_NAME=Our House

# Días que una lista archivada espera antes de borrarse sola (opcional, por defecto 15)
LIST_ARCHIVE_RETENTION_DAYS=15
